// Prebuilt keymaster/gatekeeper HAL for recovery ramdisk (FBE decrypt).
// recovery: true installs into the recovery ramdisk (not system/vendor).
// Pattern from LineageOS/OrangeFox device trees (rodin uses the same for
// its HAL bridges). Without recovery:true the modules went to
// vendor/bin/hw + system/lib64 (verified in OFOX21 build log) and were
// absent from ramdisk -> keystore2 keeps crashing.

cc_prebuilt_binary {
    name: "a25_keystore2_stock",
    srcs: ["recovery/root/system/bin/keystore2"],
    stem: "keystore2",
    recovery: true,
    check_elf_files: false,
}
cc_prebuilt_library_shared {
    name: "a25_stock_android_hardware_confirmationui_V1_ndk",
    srcs: ["recovery/root/system/lib64/stock/android.hardware.confirmationui-V1-ndk.so"],
    stem: "android.hardware.confirmationui-V1-ndk",
    recovery_available: true,
    recovery: true,
    overrides: ["android.hardware.confirmationui-V1-ndk"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_android_hardware_security_secureclock_V1_ndk",
    srcs: ["recovery/root/system/lib64/stock/android.hardware.security.secureclock-V1-ndk.so"],
    stem: "android.hardware.security.secureclock-V1-ndk",
    recovery_available: true,
    recovery: true,
    overrides: ["android.hardware.security.secureclock-V1-ndk"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_android_hardware_security_sharedsecret_V1_ndk",
    srcs: ["recovery/root/system/lib64/stock/android.hardware.security.sharedsecret-V1-ndk.so"],
    stem: "android.hardware.security.sharedsecret-V1-ndk",
    recovery_available: true,
    recovery: true,
    overrides: ["android.hardware.security.sharedsecret-V1-ndk"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_android_security_compat_ndk",
    srcs: ["recovery/root/system/lib64/stock/android.security.compat-ndk.so"],
    stem: "android.security.compat-ndk",
    recovery_available: true,
    recovery: true,
    overrides: ["android.security.compat-ndk"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_libkeystore2_aaid",
    srcs: ["recovery/root/system/lib64/stock/libkeystore2_aaid.so"],
    stem: "libkeystore2_aaid",
    recovery_available: true,
    recovery: true,
    overrides: ["libkeystore2_aaid"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_libkeystore2_apc_compat",
    srcs: ["recovery/root/system/lib64/stock/libkeystore2_apc_compat.so"],
    stem: "libkeystore2_apc_compat",
    recovery_available: true,
    recovery: true,
    overrides: ["libkeystore2_apc_compat"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_libkeystore2_crypto",
    srcs: ["recovery/root/system/lib64/stock/libkeystore2_crypto.so"],
    stem: "libkeystore2_crypto",
    recovery_available: true,
    recovery: true,
    overrides: ["libkeystore2_crypto"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_libkm_compat_service",
    srcs: ["recovery/root/system/lib64/stock/libkm_compat_service.so"],
    stem: "libkm_compat_service",
    recovery_available: true,
    recovery: true,
    overrides: ["libkm_compat_service"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_libsqlite",
    srcs: ["recovery/root/system/lib64/stock/libsqlite.so"],
    stem: "libsqlite",
    recovery_available: true,
    recovery: true,
    overrides: ["libsqlite"],
    relative_install_path: "stock",
    check_elf_files: false,
}

cc_prebuilt_binary {
    // Name prefixed to avoid collision with hardware/interfaces/keymaster/4.1/default
    // (OFOX23: "MODULE.TARGET.EXECUTABLES.android.hardware.keymaster@4.1-service
    //  already defined"). stem keeps the INSTALLED filename = original name so
    // the .rc service path /system/bin/hw/android.hardware.keymaster@4.1-service resolves.
    name: "a25_android.hardware.keymaster@4.1-service",
    srcs: ["recovery/root/system/bin/hw/android.hardware.keymaster@4.1-service"],
    stem: "android.hardware.keymaster@4.1-service",
    relative_install_path: "hw",
    recovery: true,
    check_elf_files: false,
    shared_libs: [
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}
cc_prebuilt_binary {
    // Name prefixed to avoid collision with hardware/interfaces/gatekeeper/1.0/default
    // (same module name already defined; OFOX22: "MODULE.TARGET.EXECUTABLES... already defined")
    // stem keeps the INSTALLED filename = original name so the .rc service path
    // /system/bin/hw/android.hardware.gatekeeper@1.0-service resolves.
    name: "a25_android.hardware.gatekeeper@1.0-service",
    srcs: ["recovery/root/system/bin/hw/android.hardware.gatekeeper@1.0-service"],
    stem: "android.hardware.gatekeeper@1.0-service",
    relative_install_path: "hw",
    recovery: true,
    check_elf_files: false,
    shared_libs: [
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}
