// Prebuilt keymaster/gatekeeper HAL for recovery ramdisk (FBE decrypt).
// recovery: true installs into the recovery ramdisk (not system/vendor).
// Pattern from LineageOS/OrangeFox device trees (rodin uses the same for
// its HAL bridges). Without recovery:true the modules went to
// vendor/bin/hw + system/lib64 (verified in OFOX21 build log) and were
// absent from ramdisk -> keystore2 keeps crashing.

cc_prebuilt_binary {
    name: "a25_keystore2_stock",
    srcs: ["recovery/root/system/bin/keystore2"],
    stem: "keystore2",
    recovery: true,
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_android_hardware_security_keymint_V1_cpp",
    srcs: ["recovery/root/system/lib64/stock/android.hardware.security.keymint-V1-cpp.so"],
    stem: "android.hardware.security.keymint-V1-cpp",
    recovery_available: true,
    recovery: true,
    overrides: ["android.hardware.security.keymint-V1-cpp"],
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "a25_stock_android_hardware_security_keymint_V4_ndk",
