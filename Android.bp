cc_prebuilt_binary {
    // Name prefixed to avoid collision with hardware/interfaces/keymaster/4.1/default
    // (OFOX23: "MODULE.TARGET.EXECUTABLES.android.hardware.keymaster@4.1-service
    //  already defined"). stem keeps the INSTALLED filename = original name so
    // the .rc service path /system/bin/hw/android.hardware.keymaster@4.1-service resolves.
    name: "a25_android.hardware.keymaster@4.1-service",
    srcs: ["recovery/root/system/bin/hw/android.hardware.keymaster@4.1-service"],
    stem: "android.hardware.keymaster@4.1-service",
    relative_install_path: "hw",
    recovery: true,
    check_elf_files: false,
    shared_libs: [
        "libkeymaster4_vendor",
        "libkeymaster41_vendor",
        "libkeymaster4_1support_vendor",
        "libkeymaster4support_vendor",
        "libkeymaster_messages_vendor",
        "libkeymaster_portable_vendor",
        "libpuresoftkeymasterdevice_vendor",
        "libcppbor_external_vendor",
        "libbase",
        "libcutils",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}

cc_prebuilt_binary {
    // Name prefixed to avoid collision with hardware/interfaces/gatekeeper/1.0/default
    // (same module name already defined; OFOX22: "MODULE.TARGET.EXECUTABLES... already defined")
    // stem keeps the INSTALLED filename = original name so the .rc service path
    // /system/bin/hw/android.hardware.gatekeeper@1.0-service resolves.
    name: "a25_android.hardware.gatekeeper@1.0-service",
    srcs: ["recovery/root/system/bin/hw/android.hardware.gatekeeper@1.0-service"],
    stem: "android.hardware.gatekeeper@1.0-service",
    relative_install_path: "hw",
    recovery: true,
    check_elf_files: false,
    shared_libs: [
        "libhardware",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
}

