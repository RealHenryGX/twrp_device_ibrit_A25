From: Gravity <RealHenryGX@users.noreply.github.com>
Subject: [PATCH] vold: align synthetic password key alias prefix

KeystoreInfo::getAlias() must use the same `USRSKEY_` namespace prefix
that Decrypt.cpp uses when querying the synthetic password blob key.

---
--- a/KeystoreInfo.hpp
+++ b/KeystoreInfo.hpp
@@ -19,7 +19,7 @@
 #ifndef __KEYSTOREINFO_H
 #define __KEYSTOREINFO_H

-#define SYNTHETIC_PASSWORD_KEY_PREFIX "synthetic_password_"
+#define SYNTHETIC_PASSWORD_KEY_PREFIX "USRSKEY_synthetic_password_"
 class KeystoreInfo {
 public:
 std::string getHandle(const userid_t user_id);
