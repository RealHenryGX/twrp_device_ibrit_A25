# Minimal, single-owner configfs USB state machine for recovery ADB.
# Reviewed against AOSP init phase ordering (init.rc: on late-init ->
# trigger early-fs/fs/post-fs are APPENDED after late-init actions, so a
# device-tree 'on late-init' block runs BEFORE on fs — an earlier attempt
# to "finalize" USB there ran before the configfs tree existed and was a
# no-op. Removed entirely.)
#
# Principles:
#  - controller always has an explicit local default (no dependency on
#    ro.boot.usbcontroller).
#  - sys.usb.config is only set at post-fs, AFTER on fs created the
#    configfs tree and mounted functionfs.
#  - hwservicemanager.ready no longer triggers adbd (raced configfs).
#  - stopping adbd clears sys.usb.ffs.ready immediately
#    (on property:init.svc.adbd=stopped) so a stale ready=1 never binds
#    the gadget against a dead FunctionFS instance.
#  - UDC bind happens ONLY in the ffs.ready+adb action (after adbd wrote
#    descriptors/strings to ep0), per FunctionFS lifecycle.
#  - ADB-only: no MTP / mass_storage functions created.
#  - usb_role=device pinned at post-fs before adbd starts (MTK musb).

on early-init
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller musb-hdrc
    setprop vendor.usb.controller musb-hdrc
    setprop sys.usb.ffs.aio_compat 1

on fs
    mkdir /config
    mount configfs none /config

    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell

    mkdir /config/usb_gadget/g1
    mkdir /config/usb_gadget/g1/strings/0x409
    mkdir /config/usb_gadget/g1/configs/b.1
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409
    mkdir /config/usb_gadget/g1/functions/ffs.adb

    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee7
    write /config/usb_gadget/g1/bcdUSB 0x0200
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/strings/0x409/serialnumber ${ro.serialno}
    write /config/usb_gadget/g1/strings/0x409/manufacturer ${ro.product.manufacturer}
    write /config/usb_gadget/g1/strings/0x409/product ${ro.product.model}
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration adb

    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000

on post-fs
    # Pin device role (MTK musb; node exposed by prebuilt kernel).
    write /sys/class/usb_role/mt_usb-role-switch/role device
    # Clean state, then enable adb through the prop chain.
    setprop sys.usb.config none
    setprop sys.usb.config adb

on property:sys.usb.config=none
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    setprop sys.usb.ffs.ready 0
    rm /config/usb_gadget/g1/configs/b.1/f1
    setprop sys.usb.state none

on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

on property:sys.usb.config=adb
    start adbd

on property:sys.usb.ffs.ready=1 && property:sys.usb.config=adb
    rm /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state adb
