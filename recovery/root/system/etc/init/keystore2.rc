# Recovery needs Android 12 Keystore2's AIDL endpoint for vold's FBE path.
# Mount stock system read-only first and keep its temporary database in tmpfs;
# userdata is not available until metadata decryption succeeds.
service keystore2 /system/bin/keystore2 /tmp/a25-keystore2-db
    class core
    user keystore
    group keystore
    interface aidl android.system.keystore2.IKeystoreService/default
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /system/lib64:/system/lib64/vndk-sp:/system/lib64/hw:/vendor/lib64:/vendor/lib64/hw
    stdio_to_kmsg
    seclabel u:r:recovery:s0
