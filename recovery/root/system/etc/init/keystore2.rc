# Recovery reads the Android Keystore2 namespace after userdata is mounted.
service keystore2 /system/bin/keystore2 /data/misc/keystore
    class core
    user keystore
    group keystore
    interface aidl android.system.keystore2.IKeystoreService/default
    disabled
    oneshot
    setenv LD_LIBRARY_PATH /system/lib64:/system/lib64/vndk-sp:/system/lib64/hw:/vendor/lib64:/vendor/lib64/hw
    setenv A25_KEYSTORE_READ_ONLY 1
    stdio_to_kmsg
    seclabel u:r:recovery:s0
