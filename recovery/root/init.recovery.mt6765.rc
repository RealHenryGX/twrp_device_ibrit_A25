on init
    # OrangeFox mounts the logical system partition at /system_root.  The
    # crypto HALs must start after OrangeFox has created the dm devices.
    export LD_LIBRARY_PATH /system_root/lib64:/system_root/lib64/vndk-sp:/system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1

on property:orangefox.postinit.status=1
    start vendor.keymaster-4-1
    start vendor.gatekeeper-1-0
    start keystore2

on property:orangefox.mount_to_decrypt=1
    start vendor.keymaster-4-1
    start vendor.gatekeeper-1-0
    start keystore2

service vendor.keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service
    disabled
    user system
    group system drmrpc
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    disabled
    user system
    group system
    seclabel u:r:recovery:s0

service keystore2 /system_root/system/bin/keystore2 /data/misc/keystore
    disabled
    user root
    group root system
    seclabel u:r:recovery:s0


on fs && property:ro.debuggable=0
    # NOTE: this block never fires in TWRP (eng build, ro.debuggable=1).
    # Kept verbatim from stock for reference. USB is owned by TWRP's
    # in-code init (TW_EXCLUDE_DEFAULT_USB_INIT=true, proven working).
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
