on init
    # OrangeFox owns logical system mounts. Crypto HALs start only after the
    # logical vendor partition is mounted by the helper below.
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    setprop orangefox.a25_system.ready 0

# Recovery's servicemanager does not publish servicemanager.ready itself.
# Keystore2 waits for this property before registering its AIDL service.
on property:init.svc.servicemanager=running
    setprop servicemanager.ready true

on property:init.svc.servicemanager=stopped
    setprop servicemanager.ready false

# OrangeFox's MTP backend opens /dev/usb-ffs/mtp/ep0. Provide its FunctionFS
# endpoint and combine it with ADB when TWRP sets sys.usb.config=mtp,adb.
on fs
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mkdir /tmp/a25-keystore2-db 0700 1017 1017
    start a25_mount_crypto_vendor

on fs && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp uid=0,gid=0

# TWRP Enable_MTP changes adb -> none -> mtp,adb before its MTP server opens
# FunctionFS ep0. Start both FunctionFS services, then wait for the helper to
# publish descriptors before init binds the composite gadget.
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    setprop sys.usb.ffs.mtp.ready 0
    write /config/usb_gadget/g1/UDC "none"
    start adbd
    start mtp_rebind

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1 && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    # MTP first exposes Windows WPD on MI_00.
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# The stock OrangeFox init has no configfs handler for MTP+ADB. If MTP is
# switched off, remove its function link before OrangeFox rebinds ADB alone.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

service mtp_rebind /sbin/sh /sbin/mtp_rebind.sh
    class main
    oneshot
    disabled
    seclabel u:r:recovery:s0

service a25_mount_crypto_vendor /sbin/sh /sbin/a25_mount_crypto_vendor.sh
    class core
    disabled
    oneshot
    seclabel u:r:recovery:s0

service a25_logd /system_root/system/bin/logd
    class core
    user logd
    group logd system readproc
    capabilities SYSLOG AUDIT_CONTROL
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram+passcred 0222 logd logd
    file /proc/kmsg r
    file /dev/kmsg w
    setenv LD_LIBRARY_PATH /system_root/system/lib64:/system_root/system/lib64/vndk-sp:/system_root/lib64:/system_root/lib64/vndk-sp:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled

on property:init.svc.recovery=running
    start a25_mount_crypto_vendor

# Start stock crypto services once OrangeFox has mounted logical vendor.
on property:orangefox.a25_vendor.ready=1 && property:init.svc.servicemanager=running
    start vendor.keymaster-4-1
    start vendor.gatekeeper-1-0

on property:orangefox.a25_system.ready=1 && property:init.svc.servicemanager=running
    start a25_logd

on property:orangefox.a25_system.ready=1 && property:init.svc.a25_logd=running
    start keystore2

on property:orangefox.postinit.status=1
    start a25_mount_crypto_vendor

on property:orangefox.mount_to_decrypt=1
    start a25_mount_crypto_vendor

on property:orangefox.a25_vendor.ready=0
    stop keystore2
    stop vendor.keymaster-4-1
    stop vendor.gatekeeper-1-0

on fs && property:ro.debuggable=0
    # NOTE: this block never fires in TWRP (eng build, ro.debuggable=1).
    # Kept verbatim from stock for reference. USB is owned by TWRP's
    # in-code init (TW_EXCLUDE_DEFAULT_USB_INIT=true, proven working).
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Prepare logical vendor and crypto HALs before OrangeFox recovery starts.
    start a25_mount_crypto_vendor

    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b
    symlink /dev/block/mmcblk0boot0 /dev/block/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/by-name/preloader_b

    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
